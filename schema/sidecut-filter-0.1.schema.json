{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/farkmeil/sidecut/schema/sidecut-filter-0.1.schema.json",
  "title": "sidecut filter",
  "description": "Time ranges in one specific video file, and what is in them.",
  "type": "object",
  "required": ["sidecut", "segments"],
  "properties": {
    "sidecut": { "type": "string", "pattern": "^0\\.[0-9]+$", "description": "Spec version." },
    "media": {
      "type": "object",
      "description": "The file this filter was made for. Players compare the fingerprint before applying it.",
      "properties": {
        "title": { "type": "string" },
        "year": { "type": "integer", "minimum": 0 },
        "season": { "type": "integer", "minimum": 0 },
        "episode": { "type": "integer", "minimum": 0 },
        "edition": { "type": "string", "description": "e.g. Theatrical, Director's Cut" },
        "ids": {
          "type": "object",
          "description": "External ids, e.g. imdb, tmdb, tvdb.",
          "additionalProperties": { "type": "string" }
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0, "description": "File size in bytes." },
        "oshash": { "type": "string", "pattern": "^[0-9a-fA-F]{16}$", "description": "OpenSubtitles hash." },
        "audio_language": { "type": "string", "description": "Language of the audio track language segments were timed against." }
      },
      "additionalProperties": true
    },
    "generator": { "type": "object", "additionalProperties": true },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "category"],
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "category": { "enum": ["language", "sex_nudity", "violence", "substances", "frightening", "other"] },
          "severity": { "enum": [1, 2, 3], "description": "1 mild, 2 moderate, 3 strong. Default 2." },
          "action": { "enum": ["mute", "skip"], "description": "Suggested handling. Default: mute for language, skip otherwise." },
          "tags": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" },
          "source": { "type": "string", "description": "How the segment was made: manual, subtitle, subtitle+asr, asr, ..." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
